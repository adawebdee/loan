  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>

  <script>
    const firebaseConfig={apiKey:"AIzaSyDQlQzo1yVfQOYYgNCrOcqBwLEAXKfZWCE",authDomain:"loan-17784.firebaseapp.com",databaseURL:"https://loan-17784-default-rtdb.europe-west1.firebasedatabase.app",projectId:"loan-17784",storageBucket:"loan-17784.firebasestorage.app",messagingSenderId:"30800980008",appId:"1:30800980008:web:9869d2e63a61b2e7022d1d",measurementId:"G-TLV6BKKFJG"};
    firebase.initializeApp(firebaseConfig);
    const database=firebase.database();

    let allCustomers={},allPayments={},prefixes=[];
    let activeLocation='',activeFilter='all',activeStatFilter='';
    let editPayKey=null,editPayCustId=null,delPayKey=null,delPayCustId=null;
    let addPayCustId=null,viewingCustId=null,editingCustId=null;
    let callPhoneNumber='';

    document.addEventListener('DOMContentLoaded',()=>{
      initListeners();
      document.getElementById('searchBar').addEventListener('input',()=>renderCustomerList());
      setupMonthPicker();
      setDateRangeLabels();
    });

    function initListeners(){
      database.ref('settings/prefixes').on('value',s=>{const v=s.val();if(Array.isArray(v)&&v.length){prefixes=v;renderLocationTabs()}});
      database.ref('customers').on('value',s=>{allCustomers=s.val()||{};updateAll()});
      database.ref('payments').on('value',s=>{allPayments=s.val()||{};updateAll()});
    }
    function updateAll(){updateStats();renderCustomerList();updateCollections();renderLiveFeed();renderLocationTabs()}

    /* Date helpers */
    const MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function fmtS(d){return `${d.getDate()} ${MO[d.getMonth()]}`}
    function fmtF(d){return `${d.getDate()} ${MO[d.getMonth()]} ${d.getFullYear()}`}
    function fmtISO(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
    function fmtR(s){if(!s)return'—';const d=new Date(s);return isNaN(d)?s:fmtF(d)}
    function fmt(n){return `₹${Number(n||0).toLocaleString('en-IN')}`}
    function getWB(d){const s=new Date(d);const dy=s.getDay();const df=dy===0?6:dy-1;s.setDate(s.getDate()-df);s.setHours(0,0,0,0);const e=new Date(s);e.setDate(e.getDate()+6);e.setHours(23,59,59,999);return{start:s,end:e}}

    function setDateRangeLabels(){
      const n=new Date();
      document.getElementById('todayDateRange').textContent=fmtF(n);
      const tw=getWB(n);document.getElementById('weekDateRange').textContent=`${fmtS(tw.start)} - ${fmtS(tw.end)}`;
      const lr=new Date(n);lr.setDate(lr.getDate()-7);const lw=getWB(lr);
      document.getElementById('lastWeekDateRange').textContent=`${fmtS(lw.start)} - ${fmtS(lw.end)}`;
      const ms=new Date(n.getFullYear(),n.getMonth(),1);const me=new Date(n.getFullYear(),n.getMonth()+1,0);
      document.getElementById('monthDateRange').textContent=`${fmtS(ms)} - ${fmtS(me)}`;
    }

    /* Check if date is within last 7 days */
    function isWithinWeek(dateStr){
      if(!dateStr)return false;
      const d=new Date(dateStr);if(isNaN(d))return false;
      const now=new Date();const diff=(now.getTime()-d.getTime())/(1000*60*60*24);
      return diff>=0&&diff<=7;
    }

    function isOverdue(c){
      const paid=getCustPaid(c.customerId);const total=c.totalPayable||0;
      if(total<=0||paid>=total)return false;
      const freq=c.paymentType==='weekly'?7:30;
      const payments=getCustPayments(c.customerId);
      let last=c.date?new Date(c.date):null;
      if(c.savedAt&&(!last||new Date(c.savedAt)>last))last=new Date(c.savedAt);
      payments.forEach(p=>{const pd=new Date(p.date);if(!last||pd>last)last=pd});
      if(!last)return false;
      return Math.floor((Date.now()-last.getTime())/(1000*60*60*24))>freq;
    }

    /* Location tabs */
    function renderLocationTabs(){
      const c=document.getElementById('locationTabs');c.innerHTML='';
      const allTab=document.createElement('button');
      allTab.className='location-tab'+(activeLocation===''?' active':'');
      allTab.innerHTML=`All <span class="tab-count">${Object.keys(allCustomers).length}</span>`;
      allTab.onclick=()=>{activeLocation='';renderLocationTabs();renderCustomerList()};
      c.appendChild(allTab);
      prefixes.forEach(p=>{
        const cnt=Object.values(allCustomers).filter(cu=>(cu.customerId||'').split('-')[0]===p).length;
        const t=document.createElement('button');
        t.className='location-tab'+(activeLocation===p?' active':'');
        t.innerHTML=`${esc(p)} <span class="tab-count">${cnt}</span>`;
        t.onclick=()=>{activeLocation=p;renderLocationTabs();renderCustomerList()};
        c.appendChild(t);
      });
    }

    /* Filters */
    function setFilter(f){
      activeFilter=f;activeStatFilter='';
      document.querySelectorAll('.stat-card').forEach(c=>c.classList.remove('active-stat'));
      document.querySelectorAll('.filter-tab').forEach(t=>t.classList.toggle('active',t.dataset.filter===f));
      renderCustomerList();
    }

    /* Stat card click filter */
    function statFilter(type){
      activeStatFilter=type;
      activeFilter='all';
      document.querySelectorAll('.filter-tab').forEach(t=>t.classList.remove('active'));
      document.querySelectorAll('.filter-tab[data-filter="all"]').forEach(t=>t.classList.add('active'));
      document.querySelectorAll('.stat-card').forEach(c=>c.classList.remove('active-stat'));
      if(type==='all')document.getElementById('statTotal').classList.add('active-stat');
      else if(type==='new')document.getElementById('statNew').classList.add('active-stat');
      else if(type==='pending')document.getElementById('statPending').classList.add('active-stat');
      else if(type==='completed')document.getElementById('statCompleted').classList.add('active-stat');
      renderCustomerList();
      setTimeout(()=>{
        const list=document.getElementById('customerList');
        if(list)list.scrollIntoView({behavior:'smooth',block:'start'});
      },100);
    }

    /* Stats */
    function updateStats(){
      const custs=Object.values(allCustomers);
      const now=new Date();
      let total=custs.length,nc=0,pending=0,completed=0;
      let completedThisWeek=0;

      custs.forEach(c=>{
        const cDate=c.date||'';
        if(isWithinWeek(cDate))nc++;
        else if(c.savedAt&&isWithinWeek(new Date(c.savedAt).toISOString().split('T')[0]))nc++;

        const paid=getCustPaid(c.customerId);
        if((c.totalPayable||0)>0&&paid>=(c.totalPayable||0)){
          completed++;
          // Check if completed this week (last payment within week)
          const payments=getCustPayments(c.customerId);
          if(payments.length){
            const lastPay=payments.sort((a,b)=>new Date(b.date)-new Date(a.date))[0];
            if(isWithinWeek(lastPay.date))completedThisWeek++;
          }
        } else pending++;
      });

      document.getElementById('totalCustomers').textContent=total;
      document.getElementById('newCustomers').textContent=nc;
      document.getElementById('pendingCustomers').textContent=pending;
      document.getElementById('completedCustomers').textContent=completed;

      // Sub text for new
      const tw=getWB(new Date());
      document.getElementById('newSub').textContent=nc>0?`${nc} this week · ${fmtS(tw.start)}-${fmtS(tw.end)}`:'No new this week';

      // Sub text for completed
      document.getElementById('completedSub').textContent=completedThisWeek>0?`${completedThisWeek} this week`:'';
    }

    /* Collections */
    function updateCollections(){
      const now=new Date();const todayStr=fmtISO(now);
      const tw=getWB(now);const lr=new Date(now);lr.setDate(lr.getDate()-7);const lw=getWB(lr);
      const ms=new Date(now.getFullYear(),now.getMonth(),1);
      let td=0,wk=0,lwk=0,mn=0;
      getAllPaymentsList().forEach(p=>{
        const pd=new Date(p.date);const a=Number(p.amount)||0;
        if(fmtISO(pd)===todayStr)td+=a;
        if(pd>=tw.start&&pd<=tw.end)wk+=a;
        if(pd>=lw.start&&pd<=lw.end)lwk+=a;
        if(pd>=ms&&pd<=now)mn+=a;
      });
      document.getElementById('todayCollection').textContent=fmt(td);
      document.getElementById('weekCollection').textContent=fmt(wk);
      document.getElementById('lastWeekCollection').textContent=fmt(lwk);
      document.getElementById('monthCollection').textContent=fmt(mn);
      updateChosenMonth();
    }

    function setupMonthPicker(){const p=document.getElementById('monthPicker');const n=new Date();p.value=`${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,'0')}`;p.addEventListener('change',updateChosenMonth)}
    function updateChosenMonth(){const v=document.getElementById('monthPicker').value;if(!v)return;const[y,m]=v.split('-').map(Number);const s=new Date(y,m-1,1);const e=new Date(y,m,0,23,59,59,999);let t=0;getAllPaymentsList().forEach(p=>{const pd=new Date(p.date);if(pd>=s&&pd<=e)t+=(Number(p.amount)||0)});document.getElementById('chosenMonthCollection').textContent=fmt(t)}

    /* Live feed */
    function renderLiveFeed(){
      const feed=document.getElementById('liveFeed');const todayStr=fmtISO(new Date());
      const tp=getAllPaymentsList().filter(p=>fmtISO(new Date(p.date))===todayStr).sort((a,b)=>(b.timestamp||0)-(a.timestamp||0));
      if(!tp.length){feed.innerHTML='<div class="live-empty">No payments today yet</div>';return}
      feed.innerHTML=tp.map(p=>{
        const c=findCust(p.customerId);const nm=c?c.name:(p.customerName||p.customerId);
        const tm=p.timestamp?new Date(p.timestamp).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}):'';
        return `<div class="live-item"><div class="live-dot"></div><div class="live-info"><div class="live-name">${esc(nm)}</div><div class="live-detail">${esc(p.customerId)} · ${tm}</div></div><div class="live-amount">${fmt(p.amount)}</div></div>`;
      }).join('');
    }

    /* ===== CUSTOMER LIST ===== */
    function renderCustomerList(){
      const container=document.getElementById('customerList');
      const countEl=document.getElementById('listCount');
      const search=(document.getElementById('searchBar').value||'').trim().toLowerCase();
      let custs=Object.values(allCustomers);

      if(activeLocation)custs=custs.filter(c=>(c.customerId||'').split('-')[0]===activeLocation);

      custs=custs.map(c=>{
        const paid=getCustPaid(c.customerId);const total=c.totalPayable||0;
        const pct=total>0?Math.min(100,Math.round((paid/total)*100)):0;
        const ov=isOverdue(c);
        const cDate=c.date||'';
        const isNew=isWithinWeek(cDate)||(c.savedAt&&isWithinWeek(new Date(c.savedAt).toISOString().split('T')[0]));
        let status='pending';
        if(total>0&&paid>=total)status='completed';
        else if(ov)status='overdue';
        return{...c,_paid:paid,_pending:Math.max(0,total-paid),_pct:pct,_status:status,_isNew:isNew};
      });

      // Apply stat filter
      if(activeStatFilter==='new')custs=custs.filter(c=>c._isNew);
      else if(activeStatFilter==='pending')custs=custs.filter(c=>c._status==='pending'||c._status==='overdue');
      else if(activeStatFilter==='completed')custs=custs.filter(c=>c._status==='completed');

      // Apply regular filter
      if(activeFilter==='pending')custs=custs.filter(c=>c._status==='pending');
      else if(activeFilter==='completed')custs=custs.filter(c=>c._status==='completed');
      else if(activeFilter==='overdue')custs=custs.filter(c=>c._status==='overdue');

      if(search)custs=custs.filter(c=>(c.name||'').toLowerCase().includes(search)||(c.customerId||'').toLowerCase().includes(search)||(c.phone||'').toLowerCase().includes(search));

      // Sort by ID number descending (newest first)
      custs.sort((a,b)=>{
        const aNum=parseInt((a.customerId||'').split('-').pop())||0;
        const bNum=parseInt((b.customerId||'').split('-').pop())||0;
        return bNum-aNum;
      });

      // Show count
      if(custs.length>0){
        countEl.style.display='flex';
        let label='Customers';
        if(activeStatFilter==='new')label='New Customers (This Week)';
        else if(activeStatFilter==='pending')label='Pending Customers';
        else if(activeStatFilter==='completed')label='Completed Customers';
        else if(activeFilter==='overdue')label='Overdue Customers';
        else if(activeFilter==='pending')label='Pending Customers';
        else if(activeFilter==='completed')label='Completed Customers';
        countEl.innerHTML=`Showing <span class="count-num">${custs.length}</span> ${label}`;
      } else {
        countEl.style.display='none';
      }

      if(!custs.length){
        container.innerHTML=`<div class="no-data"><div class="nd-icon">${activeLocation?'📭':'👆'}</div><div class="nd-text">${activeStatFilter||activeFilter!=='all'?'No customers found for this filter':'Tap Total or a location to view customers'}</div></div>`;
        return;
      }

      container.innerHTML=custs.map(c=>{
        const barClass=c._pct>=100?'green':(c._pct>=50?'orang':'red');
        const pctColor=c._pct>=100?'var(--success)':(c._pct>=50?'var(--warning)':'var(--danger)');
        const badgeClass=c._status==='completed'?'badge-completed':(c._status==='overdue'?'badge-overdue':'badge-pending');
        const badgeText=c._status==='completed'?'Completed':(c._status==='overdue'?'Overdue':'Pending');
        const phone=c.phone||'';
        const sid=safeId(c.customerId);
        const startDate=c.date?fmtR(c.date):(c.savedAt?fmtR(new Date(c.savedAt).toISOString().split('T')[0]):'—');
        const payments=getCustPayments(c.customerId).sort((a,b)=>new Date(b.date)-new Date(a.date));

        return `<div class="customer-box ${c._status}" id="cbox-${sid}">
          <div class="customer-main">
            <div class="customer-top">
              <div class="customer-info">
                <div class="customer-name">${esc(c.name||'—')}</div>
                <div class="customer-meta">
                  <span class="customer-id">${esc(c.customerId)}</span>
                  <span class="customer-status-badge ${badgeClass}">${badgeText}</span>
                  ${c._isNew?'<span class="customer-status-badge badge-new">NEW</span>':''}
                </div>
                <div class="customer-date-small">Started: ${startDate}</div>
              </div>
              <div class="customer-actions">
                <button class="icon-btn call" title="Call" onclick="openCallModal('${esc(c.name||'')}','${esc(phone)}')">
                               <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.11 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </button>
                <button class="icon-btn details" title="Details" onclick="openCustomerDetail('${esc(c.customerId)}')">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                </button>
              </div>
            </div>
            <div class="customer-progress">
              <div class="progress-row"><span class="pr-label">Paid</span><span class="pr-value paid">${fmt(c._paid)}</span></div>
              <div class="progress-row"><span class="pr-label">Pending</span><span class="pr-value pend">${fmt(c._pending)}</span></div>
              <div class="progress-bar-wrap"><div class="progress-bar ${barClass}" style="width:${c._pct}%"></div></div>
              <div class="progress-percent" style="color:${pctColor}">${c._pct}% paid</div>
            </div>
          </div>
          <div class="customer-bottom-actions">
            <button class="cba-btn pay" onclick="openAddPaymentModal('${esc(c.customerId)}')">💰 Add Payment</button>
            <button class="cba-btn view" id="viewbtn-${sid}" onclick="toggleHistory('${sid}')">📋 History <span class="arrow">▼</span></button>
          </div>
          <div class="payment-history" id="history-${sid}">
            <div class="ph-title">Payment History</div>
            ${payments.length===0?'<div class="payment-empty">No payments yet</div>':payments.map(p=>`
              <div class="payment-item">
                <div class="pi-left"><div class="pi-date">${fmtR(p.date)}</div><div class="pi-time">${p.timestamp?new Date(p.timestamp).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}):''}</div></div>
                <div class="pi-right">
                  <span class="pi-amount">${fmt(p.amount)}</span>
                  <button class="pi-action edit" onclick="openEditPaymentModal('${esc(c.customerId)}','${esc(p._key)}','${p.date}',${p.amount})" title="Edit">✏️</button>
                  <button class="pi-action del" onclick="openDeletePaymentModal('${esc(c.customerId)}','${esc(p._key)}','${p.date}',${p.amount})" title="Delete">🗑</button>
                </div>
              </div>
            `).join('')}
            <button class="btn btn-ghost btn-sm btn-full" style="margin-top:10px" onclick="toggleHistory('${sid}')">Done ✓</button>
          </div>
        </div>`;
      }).join('');
    }

    function toggleHistory(sid){
      const h=document.getElementById('history-'+sid);if(!h)return;
      const isOpen=h.classList.contains('show');h.classList.toggle('show');
      const vb=document.getElementById('viewbtn-'+sid);
      if(vb){
        vb.classList.toggle('open');
        const span=vb.querySelector('span');
        // no text change needed, arrow rotates via CSS
      }
      if(!isOpen)setTimeout(()=>h.scrollIntoView({behavior:'smooth',block:'nearest'}),100);
    }

    /* ===== PHONE CALL MODAL ===== */
    function openCallModal(name,phone){
      if(!phone){showToast('No phone number available');return}
      callPhoneNumber=phone;
      document.getElementById('callModalName').textContent=name||'Customer';
      document.getElementById('callModalNumber').textContent=phone;
      document.getElementById('callModalLink').href='tel:'+phone;
      document.getElementById('callModal').classList.add('show');
    }

    function copyPhone(){
      if(!callPhoneNumber)return;
      navigator.clipboard.writeText(callPhoneNumber).then(()=>{
        showToast('📋 Phone number copied!');
      }).catch(()=>{
        // Fallback
        const ta=document.createElement('textarea');ta.value=callPhoneNumber;
        document.body.appendChild(ta);ta.select();document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('📋 Phone number copied!');
      });
    }

    /* ===== ADD PAYMENT ===== */
    function openAddPaymentModal(custId){
      addPayCustId=custId;
      const c=findCust(custId);
      document.getElementById('addPaymentInfo').textContent=`${c?c.name:custId} — ${custId}`;
      document.getElementById('addPaymentDate').value=fmtISO(new Date());
      document.getElementById('addPaymentAmount').value='';
      document.getElementById('addPaymentModal').classList.add('show');
      setTimeout(()=>document.getElementById('addPaymentAmount').focus(),100);
    }

    function saveAddPayment(){
      if(!addPayCustId)return;
      const amt=Number(document.getElementById('addPaymentAmount').value);
      const dt=document.getElementById('addPaymentDate').value;
      if(!amt||amt<=0){alert('Enter valid amount');return}
      if(!dt){alert('Select date');return}
      const sk=addPayCustId.replace(/[.$#[\]/]/g,'_');
      const c=findCust(addPayCustId);
      const payData={customerId:addPayCustId,customerName:c?c.name:'',amount:amt,date:dt,timestamp:Date.now()};
      database.ref('payments/'+sk).push(payData)
        .then(()=>{closeModal('addPaymentModal');addPayCustId=null;showToast('💰 Payment added!')})
        .catch(err=>{console.error(err);alert('Failed to save payment')});
    }

    /* ===== EDIT PAYMENT ===== */
    function openEditPaymentModal(custId,payKey,date,amount){
      editPayCustId=custId;editPayKey=payKey;
      document.getElementById('editPaymentInfo').textContent=`Editing payment for ${custId}`;
      document.getElementById('editPaymentDate').value=date||'';
      document.getElementById('editPaymentAmount').value=amount||'';
      document.getElementById('editPaymentModal').classList.add('show');
      setTimeout(()=>document.getElementById('editPaymentAmount').focus(),100);
    }

    function saveEditPayment(){
      if(!editPayCustId||!editPayKey)return;
      const amt=Number(document.getElementById('editPaymentAmount').value);
      const dt=document.getElementById('editPaymentDate').value;
      if(!amt||amt<=0){alert('Enter valid amount');return}
      if(!dt){alert('Select date');return}
      const sk=editPayCustId.replace(/[.$#[\]/]/g,'_');
      database.ref(`payments/${sk}/${editPayKey}`).update({amount:amt,date:dt,editedAt:Date.now()})
        .then(()=>{closeModal('editPaymentModal');editPayCustId=null;editPayKey=null;showToast('✏️ Payment updated!')})
        .catch(err=>{console.error(err);alert('Failed to update')});
    }

    /* ===== DELETE PAYMENT ===== */
    function openDeletePaymentModal(custId,payKey,date,amount){
      delPayCustId=custId;delPayKey=payKey;
      document.getElementById('deletePaymentInfo').textContent=`Delete payment of ${fmt(amount)} on ${fmtR(date)} for ${custId}?`;
      document.getElementById('deletePaymentModal').classList.add('show');
    }

    function confirmDeletePayment(){
      if(!delPayCustId||!delPayKey)return;
      const sk=delPayCustId.replace(/[.$#[\]/]/g,'_');
      database.ref(`payments/${sk}/${delPayKey}`).remove()
        .then(()=>{closeModal('deletePaymentModal');delPayCustId=null;delPayKey=null;showToast('🗑 Payment deleted!')})
        .catch(err=>{console.error(err);alert('Failed to delete')});
    }

    /* ===== CUSTOMER DETAILS MODAL ===== */
    function openCustomerDetail(custId){
      viewingCustId=custId;
      const c=findCust(custId);
      if(!c){alert('Customer not found');return}

      const paid=getCustPaid(custId);const total=c.totalPayable||0;
      const pending=Math.max(0,total-paid);
      const pct=total>0?Math.min(100,Math.round((paid/total)*100)):0;
      const commission=c.commissionFee||0;
      const custReceives=c.customerReceives||0;
      const interestAmt=c.interestAmount||0;
      const installAmt=c.installmentAmount||0;
      const payType=(c.paymentType||'monthly');
      const payTypeLabel=payType.charAt(0).toUpperCase()+payType.slice(1);
      const startDate=c.date?fmtR(c.date):(c.savedAt?fmtR(new Date(c.savedAt).toISOString().split('T')[0]):'—');

      document.getElementById('detailModalTitle').textContent=c.name||custId;

      let html=`
        <div class="detail-grid">
          <div class="detail-item">
            <div class="di-label">Customer ID</div>
            <div class="di-value" style="color:var(--accent-blue)">${esc(custId)}</div>
            <button class="copy-btn" onclick="copyText('${esc(custId)}',this)" title="Copy">📋</button>
          </div>
          <div class="detail-item">
            <div class="di-label">Start Date</div>
            <div class="di-value">${startDate}</div>
          </div>
          <div class="detail-item">
            <div class="di-label">Name</div>
            <div class="di-value">${esc(c.name||'—')}</div>
            <button class="copy-btn" onclick="copyText('${esc(c.name||'')}',this)" title="Copy">📋</button>
          </div>
          <div class="detail-item">
            <div class="di-label">Parent Name</div>
            <div class="di-value">${esc(c.parentName||'—')}</div>
          </div>
          <div class="detail-item">
            <div class="di-label">Phone</div>
            <div class="di-value"><a href="tel:${esc(c.phone||'')}" style="color:var(--success);text-decoration:none;font-weight:700">${esc(c.phone||'—')} 📞</a></div>
            <button class="copy-btn" onclick="copyText('${esc(c.phone||'')}',this)" title="Copy">📋</button>
          </div>
          <div class="detail-item">
            <div class="di-label">Aadhar</div>
            <div class="di-value">${esc(c.aadhar||'—')}</div>
            <button class="copy-btn" onclick="copyText('${esc(c.aadhar||'')}',this)" title="Copy">📋</button>
          </div>
          <div class="detail-item full">
            <div class="di-label">Address</div>
            <div class="di-value">${esc(c.address||'—')}</div>
            <button class="copy-btn" onclick="copyText(\`${esc(c.address||'')}\`,this)" title="Copy">📋</button>
          </div>
          <div class="detail-item">
            <div class="di-label">State</div>
            <div class="di-value">${esc(c.state||'—')}</div>
          </div>
          <div class="detail-item">
            <div class="di-label">City</div>
            <div class="di-value">${esc(c.city||'—')}</div>
          </div>
        </div>

        <div class="detail-summary">
          <div style="text-align:center;font-size:12px;font-weight:700;color:var(--accent-blue);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px">💰 Loan Summary</div>
          <div class="ds-row"><span class="ds-label">Loan Amount</span><span class="ds-value">${fmt(c.loanAmount)}</span></div>
          <div class="ds-row"><span class="ds-label">Commission</span><span class="ds-value" style="color:var(--danger)">- ${fmt(commission)}</span></div>
          <div class="ds-row"><span class="ds-label">Customer Received</span><span class="ds-value" style="color:var(--success)">${fmt(custReceives)}</span></div>
          <div class="ds-row"><span class="ds-label">Interest (${c.interestRate||0}%)</span><span class="ds-value">${fmt(interestAmt)}</span></div>
          <div class="ds-row"><span class="ds-label">Total Payable</span><span class="ds-value" style="color:var(--accent-blue);font-size:16px">${fmt(total)}</span></div>
        </div>

        <div class="detail-summary" style="background:rgba(39,196,140,0.06);border-color:rgba(39,196,140,0.1)">
          <div style="text-align:center;font-size:12px;font-weight:700;color:var(--success);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px">✅ Payment Status</div>
          <div class="ds-row"><span class="ds-label">Total Paid</span><span class="ds-value" style="color:var(--success)">${fmt(paid)}</span></div>
          <div class="ds-row"><span class="ds-label">Remaining</span><span class="ds-value" style="color:var(--warning)">${fmt(pending)}</span></div>
          <div class="ds-row"><span class="ds-label">Progress</span><span class="ds-value" style="color:${pct>=100?'var(--success)':(pct>=50?'var(--warning)':'var(--danger)')}">${pct}%</span></div>
          <div style="margin-top:8px">
            <div class="progress-bar-wrap" style="height:10px;border-radius:5px">
              <div class="progress-bar ${pct>=100?'green':(pct>=50?'orang':'red')}" style="width:${pct}%;border-radius:5px"></div>
            </div>
          </div>
        </div>

        <div class="detail-summary" style="background:rgba(168,85,247,0.06);border-color:rgba(168,85,247,0.1)">
          <div style="text-align:center;font-size:12px;font-weight:700;color:var(--purple);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px">📅 Payment Plan</div>
          <div class="ds-row"><span class="ds-label">Type</span><span class="ds-value">${payTypeLabel}</span></div>
          <div class="ds-row"><span class="ds-label">Installment</span><span class="ds-value">${fmt(installAmt)}</span></div>
          <div class="ds-row"><span class="ds-label">Total Installments</span><span class="ds-value">${c.numberOfInstallments||0}</span></div>
          <div class="ds-row"><span class="ds-label">Paid Installments</span><span class="ds-value" style="color:var(--success)">${installAmt>0?Math.floor(paid/installAmt):0}</span></div>
          <div class="ds-row"><span class="ds-label">Remaining</span><span class="ds-value" style="color:var(--warning)">${installAmt>0?Math.max(0,Math.ceil(pending/installAmt)):0}</span></div>
        </div>
      `;

      document.getElementById('customerDetailContent').innerHTML=html;
      document.getElementById('customerDetailModal').classList.add('show');
