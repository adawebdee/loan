
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" />
  <title>SR Finance — Admin Panel</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
    :root{
      --bg:#071017;--surface:#0d1a24;--text:#e6f0f6;--muted:#7a8a99;
      --accent-blue:#0b5ed7;--accent-blue-2:#084ab0;
      --success:#27c48c;--danger:#ff6b6b;--warning:#f0a500;--orange:#ff8c42;--purple:#a855f7;--cyan:#22d3ee;
      --border:rgba(255,255,255,0.04);--radius:16px;
      --card-shadow:0 8px 32px rgba(0,0,0,0.5);
      --glass:rgba(255,255,255,0.02);
      --gradient-surface:linear-gradient(180deg,var(--surface),#071422);
      --gradient-header:linear-gradient(90deg,rgba(3,8,12,0.97),rgba(7,18,24,0.97));
    }
    html,body{height:100%}
    body{background:linear-gradient(180deg,var(--bg),#021018 160%);color:var(--text);font-family:'Inter',ui-sans-serif,system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh;line-height:1.5;padding-bottom:80px;font-size:15px}
    header{position:sticky;top:0;z-index:80;background:var(--gradient-header);border-bottom:1px solid var(--border);backdrop-filter:blur(12px);padding:12px 16px;box-shadow:0 6px 24px rgba(3,8,12,0.6)}
    .header-inner{max-width:700px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px}
    .brand{display:flex;align-items:center;gap:10px}
    .logo{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(--accent-blue),var(--accent-blue-2));display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--text);font-size:16px;box-shadow:0 8px 20px rgba(11,94,215,0.15);flex-shrink:0}
    .brand h1{font-size:16px;margin:0;font-weight:700}
    .brand p{margin:0;color:var(--muted);font-size:12px}
    .page{max-width:700px;margin:12px auto;padding:0 12px}

    /* Action chips */
    .action-row{display:flex;gap:6px;margin-bottom:14px}
    .action-chip{display:inline-flex;align-items:center;gap:5px;padding:8px 12px;border-radius:10px;border:none;cursor:pointer;font-family:inherit;font-size:12px;font-weight:700;min-height:36px;transition:all 0.15s ease}
    .action-chip:active{transform:scale(0.95)}
    .action-chip.green{background:rgba(39,196,140,0.12);color:var(--success);border:1px solid rgba(39,196,140,0.15)}
    .action-chip.orange{background:rgba(240,165,0,0.12);color:var(--warning);border:1px solid rgba(240,165,0,0.15)}

    /* ===== CLICKABLE STAT CARDS ===== */
    .stats-row{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:14px}
    @media(min-width:480px){.stats-row{grid-template-columns:repeat(4,1fr)}}
    .stat-card{
      position:relative;overflow:hidden;border-radius:14px;padding:14px 12px;
      min-height:80px;display:flex;flex-direction:column;justify-content:space-between;
      cursor:pointer;transition:all 0.15s ease;-webkit-user-select:none;user-select:none;
    }
    .stat-card:active{transform:scale(0.97)}
    .stat-card.active-stat{box-shadow:0 0 0 2px rgba(255,255,255,0.2),0 8px 24px rgba(0,0,0,0.3)}
    .stat-card::before{content:'';position:absolute;top:0;right:0;width:60px;height:60px;border-radius:50%;opacity:0.08;transform:translate(15px,-15px)}
    .stat-card.s-total{background:linear-gradient(135deg,#0d2847,#0a1f3a);border:1px solid rgba(11,94,215,0.15)}
    .stat-card.s-total::before{background:var(--accent-blue)}
    .stat-card.s-total.active-stat{border-color:var(--accent-blue)}
    .stat-card.s-new{background:linear-gradient(135deg,#0d2e2a,#0a2520);border:1px solid rgba(39,196,140,0.15)}
    .stat-card.s-new::before{background:var(--success)}
    .stat-card.s-new.active-stat{border-color:var(--success)}
    .stat-card.s-pending{background:linear-gradient(135deg,#2e2510,#25200a);border:1px solid rgba(240,165,0,0.15)}
    .stat-card.s-pending::before{background:var(--warning)}
    .stat-card.s-pending.active-stat{border-color:var(--warning)}
    .stat-card.s-completed{background:linear-gradient(135deg,#1a1035,#15102a);border:1px solid rgba(168,85,247,0.15)}
    .stat-card.s-completed::before{background:var(--purple)}
    .stat-card.s-completed.active-stat{border-color:var(--purple)}
    .stat-icon-circle{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;margin-bottom:4px}
    .stat-card.s-total .stat-icon-circle{background:rgba(11,94,215,0.15)}
    .stat-card.s-new .stat-icon-circle{background:rgba(39,196,140,0.15)}
    .stat-card.s-pending .stat-icon-circle{background:rgba(240,165,0,0.15)}
    .stat-card.s-completed .stat-icon-circle{background:rgba(168,85,247,0.15)}
    .stat-card .stat-value{font-size:24px;font-weight:800;margin:2px 0}
    .stat-card.s-total .stat-value{color:var(--accent-blue)}
    .stat-card.s-new .stat-value{color:var(--success)}
    .stat-card.s-pending .stat-value{color:var(--warning)}
    .stat-card.s-completed .stat-value{color:var(--purple)}
    .stat-card .stat-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;font-weight:600}
    .stat-card .stat-sub{font-size:9px;color:rgba(122,138,153,0.7);margin-top:2px;font-weight:500;line-height:1.3}

    /* Collection Cards */
    .collection-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:14px}
    @media(min-width:480px){.collection-grid{grid-template-columns:repeat(4,1fr)}}
    .collection-card{background:var(--gradient-surface);border:1px solid var(--border);border-radius:14px;padding:12px;box-shadow:var(--card-shadow);position:relative;overflow:hidden}
    .collection-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:3px}
    .collection-card.today::before{background:var(--success)}
    .collection-card.week::before{background:var(--accent-blue)}
    .collection-card.lastweek::before{background:var(--orange)}
    .collection-card.month::before{background:var(--purple)}
    .cc-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;font-weight:600}
    .cc-date{font-size:9px;color:rgba(122,138,153,0.65);margin-top:1px;font-weight:500}
    .cc-value{font-size:18px;font-weight:800;margin-top:4px}
    .collection-card.today .cc-value{color:var(--success)}
    .collection-card.week .cc-value{color:var(--accent-blue)}
    .collection-card.lastweek .cc-value{color:var(--orange)}
    .collection-card.month .cc-value{color:var(--purple)}

    .month-selector{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap}
    .month-selector label{font-size:12px;color:var(--muted);font-weight:600;margin:0}
    .month-selector input[type="month"]{padding:8px 12px;border-radius:10px;background:var(--glass);border:1px solid rgba(255,255,255,0.06);color:var(--text);font-size:13px;font-family:inherit;min-height:38px}
    .month-selector input:focus{outline:none;border-color:rgba(11,94,215,0.4)}
    .month-collection-value{font-size:16px;font-weight:800;color:var(--warning);margin-left:auto}

    .card{background:var(--gradient-surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--card-shadow);overflow:hidden;margin-bottom:14px}
    .card-header{padding:12px 14px;border-bottom:1px solid rgba(255,255,255,0.03);display:flex;align-items:center;justify-content:space-between}
    .card-title{font-weight:700;color:var(--accent-blue);font-size:12px;text-transform:uppercase;letter-spacing:0.5px;display:flex;align-items:center;gap:6px}
    .card-content{padding:14px}

    .section-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:8px;display:flex;align-items:center;gap:6px}
    .location-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
    .location-tab{border:1px solid rgba(255,255,255,0.08);background:transparent;color:var(--text);padding:9px 14px;border-radius:12px;font-weight:600;font-size:13px;cursor:pointer;font-family:inherit;transition:all 0.15s ease;min-height:40px;display:flex;align-items:center;gap:5px}
    .location-tab:active{transform:scale(0.97)}
    .location-tab.active{background:linear-gradient(135deg,var(--accent-blue),var(--accent-blue-2));border-color:transparent;color:white;box-shadow:0 6px 20px rgba(11,94,215,0.25)}
    .location-tab .tab-count{background:rgba(255,255,255,0.15);padding:2px 7px;border-radius:7px;font-size:11px;font-weight:700}
    .location-tab.active .tab-count{background:rgba(255,255,255,0.25)}

    .filter-tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
    .filter-tab{border:1px solid rgba(255,255,255,0.06);background:transparent;color:var(--muted);padding:7px 12px;border-radius:10px;font-weight:600;font-size:12px;cursor:pointer;font-family:inherit;min-height:34px;transition:all 0.15s ease}
    .filter-tab.active{background:rgba(11,94,215,0.12);color:var(--accent-blue);border-color:rgba(11,94,215,0.2)}
    .filter-tab.overdue-tab.active{background:rgba(255,107,107,0.12);color:var(--danger);border-color:rgba(255,107,107,0.2)}

    .search-wrap{position:relative;margin-bottom:12px}
    .search-bar{width:100%;padding:11px 14px 11px 40px;border-radius:12px;background:var(--glass);border:1px solid rgba(255,255,255,0.06);color:var(--text);font-size:14px;font-family:inherit;min-height:44px}
    .search-bar:focus{outline:none;border-color:rgba(11,94,215,0.4);box-shadow:0 0 0 3px rgba(11,94,215,0.1)}
    .search-bar::placeholder{color:rgba(230,240,246,0.25)}
    .search-wrap .search-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none}

    /* Customer list count label */
    .list-count{font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:600;display:flex;align-items:center;gap:6px}
    .list-count .count-num{color:var(--accent-blue);font-weight:800}

    .customer-list{display:flex;flex-direction:column;gap:10px}
    .customer-box{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);border-radius:14px;overflow:hidden;transition:all 0.2s ease}
    .customer-box.completed{border-left:3px solid var(--success)}
    .customer-box.pending{border-left:3px solid var(--warning)}
    .customer-box.overdue{border-left:3px solid var(--danger)}
    .customer-main{padding:14px;display:flex;flex-direction:column;gap:10px}
    .customer-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
    .customer-info{flex:1;min-width:0}
    .customer-name{font-weight:700;font-size:15px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .customer-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
    .customer-id{font-size:12px;color:var(--accent-blue);font-weight:600}
    .customer-date-small{font-size:10px;color:rgba(122,138,153,0.6);font-weight:500}
    .customer-status-badge{display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px}
    .badge-pending{background:rgba(240,165,0,0.12);color:var(--warning)}
    .badge-completed{background:rgba(39,196,140,0.12);color:var(--success)}
    .badge-overdue{background:rgba(255,107,107,0.12);color:var(--danger)}
    .badge-new{background:rgba(34,211,238,0.12);color:var(--cyan);margin-left:4px}
    .customer-actions{display:flex;gap:6px;align-items:center;flex-shrink:0}
    .icon-btn{width:40px;height:40px;border-radius:10px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:all 0.15s ease;text-decoration:none}
    .icon-btn:active{transform:scale(0.93)}
    .icon-btn.call{background:rgba(39,196,140,0.1);color:var(--success)}
    .icon-btn.details{background:rgba(11,94,215,0.1);color:var(--accent-blue)}

    .customer-progress{display:flex;flex-direction:column;gap:5px}
    .progress-row{display:flex;justify-content:space-between;align-items:center;font-size:12px}
    .pr-label{color:var(--muted)}.pr-value{font-weight:700}
    .pr-value.paid{color:var(--success)}.pr-value.pend{color:var(--warning)}
    .progress-bar-wrap{width:100%;height:7px;border-radius:4px;background:rgba(255,255,255,0.06);overflow:hidden}
    .progress-bar{height:100%;border-radius:4px;transition:width 0.4s ease;min-width:2px}
    .progress-bar.green{background:linear-gradient(90deg,var(--success),#20e89a)}
    .progress-bar.orang{background:linear-gradient(90deg,var(--warning),var(--orange))}
    .progress-bar.red{background:linear-gradient(90deg,var(--danger),#ff4444)}
    .progress-percent{font-size:11px;font-weight:700;text-align:right;margin-top:1px}

    .customer-bottom-actions{display:flex;border-top:1px solid rgba(255,255,255,0.03)}
    .cba-btn{flex:1;padding:10px;border:none;cursor:pointer;background:transparent;color:var(--muted);font-weight:600;font-size:12px;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:5px;transition:all 0.15s ease}
    .cba-btn:active{background:rgba(255,255,255,0.03)}
    .cba-btn+.cba-btn{border-left:1px solid rgba(255,255,255,0.03)}
    .cba-btn.pay{color:var(--success)}.cba-btn.view{color:var(--accent-blue)}
    .cba-btn .arrow{transition:transform 0.2s ease;font-size:10px}
    .cba-btn.open .arrow{transform:rotate(180deg)}

    .payment-history{display:none;background:rgba(0,0,0,0.15);padding:14px;border-top:1px solid rgba(255,255,255,0.03)}
    .payment-history.show{display:block}
    .ph-title{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;font-weight:700}
    .payment-item{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-radius:10px;background:rgba(255,255,255,0.02);margin-bottom:6px}
    .payment-item:last-of-type{margin-bottom:0}
    .pi-left .pi-date{font-size:13px;font-weight:600}
    .pi-left .pi-time{font-size:11px;color:var(--muted)}
    .pi-right{display:flex;align-items:center;gap:5px}
    .pi-amount{font-size:14px;font-weight:700;color:var(--success)}
    .pi-action{width:30px;height:30px;border-radius:8px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;background:transparent;transition:all 0.15s ease}
    .pi-action:active{transform:scale(0.9)}
    .pi-action.edit{color:var(--accent-blue)}
    .pi-action.del{color:var(--danger)}
    .payment-empty{text-align:center;color:var(--muted);font-size:13px;padding:16px}

    .live-feed{max-height:180px;overflow-y:auto}
    .live-item{display:flex;align-items:center;gap:10px;padding:10px;border-radius:10px;background:rgba(39,196,140,0.04);border:1px solid rgba(39,196,140,0.08);margin-bottom:6px;animation:fadeIn 0.3s ease}
    @keyframes fadeIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
    .live-dot{width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0;animation:pulse 1.5s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
    .live-info{flex:1;min-width:0}
    .live-name{font-weight:700;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .live-detail{font-size:11px;color:var(--muted)}
    .live-amount{font-weight:800;color:var(--success);font-size:14px;flex-shrink:0}
    .live-empty{text-align:center;color:var(--muted);font-size:13px;padding:16px}

    .btn{border:none;cursor:pointer;font-weight:700;border-radius:12px;padding:12px 16px;font-family:inherit;font-size:14px;transition:all 0.15s ease;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:6px;-webkit-user-select:none;user-select:none}
    .btn:active{transform:scale(0.97)}
    .btn-primary{background:linear-gradient(135deg,var(--accent-blue),var(--accent-blue-2));color:white;box-shadow:0 8px 24px rgba(11,94,215,0.25)}
    .btn-success{background:linear-gradient(135deg,var(--success),#1fa872);color:white}
    .btn-ghost{background:transparent;border:1px solid var(--border);color:var(--text)}
    .btn-danger{background:rgba(255,107,107,0.12);color:var(--danger);border:1px solid rgba(255,107,107,0.15)}
    .btn-sm{padding:8px 12px;font-size:12px;min-height:36px;border-radius:10px}
    .btn-full{width:100%}

    .modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);backdrop-filter:blur(6px);z-index:200;align-items:flex-end;justify-content:center;padding:0}
    .modal.show{display:flex}
    .modal-content{width:100%;max-width:600px;background:var(--gradient-surface);border-radius:20px 20px 0 0;padding:20px 16px 32px;border:1px solid var(--border);box-shadow:0 -20px 60px rgba(0,0,0,0.5);max-height:90vh;overflow-y:auto}
    @media(min-width:520px){.modal{align-items:center;padding:20px}.modal-content{border-radius:20px;max-height:85vh}}
    .modal-handle{width:40px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;margin:0 auto 14px}
    .modal-header{font-weight:800;color:var(--text);margin-bottom:14px;font-size:17px;text-align:center}
    .modal-input{width:100%;padding:13px 14px;border-radius:12px;background:var(--glass);border:1px solid rgba(255,255,255,0.06);color:var(--text);margin-bottom:10px;font-size:15px;min-height:46px;font-family:inherit}
    .modal-input:focus{outline:none;border-color:rgba(11,94,215,0.4)}
    .modal-label{display:block;font-size:12px;color:var(--muted);font-weight:600;margin-bottom:5px}
    .modal-actions{display:flex;gap:8px;margin-top:14px}
    .modal-actions .btn{flex:1}

    .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
    .detail-item{padding:10px;background:rgba(255,255,255,0.02);border-radius:10px;border:1px solid rgba(255,255,255,0.03);position:relative}
    .detail-item .di-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;font-weight:600}
    .detail-item .di-value{font-size:14px;font-weight:600;margin-top:3px;word-break:break-word;padding-right:28px}
    .detail-item.full{grid-column:1/-1}
    .copy-btn{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:7px;border:none;cursor:pointer;background:rgba(11,94,215,0.1);color:var(--accent-blue);display:flex;align-items:center;justify-content:center;font-size:12px;transition:all 0.15s ease}
    .copy-btn:active{transform:scale(0.9);background:rgba(11,94,215,0.2)}
    .copy-btn.copied{background:rgba(39,196,140,0.15);color:var(--success)}

    .detail-summary{background:rgba(11,94,215,0.06);border:1px solid rgba(11,94,215,0.1);border-radius:14px;padding:14px;margin-bottom:14px}
    .ds-row{display:flex;justify-content:space-between;padding:5px 0;font-size:13px}
    .ds-row+.ds-row{border-top:1px solid rgba(255,255,255,0.03)}
    .ds-row .ds-label{color:var(--muted)}.ds-row .ds-value{font-weight:700}

    /* Phone call modal */
    .call-modal-number{font-size:28px;font-weight:800;color:var(--success);text-align:center;margin:16px 0;letter-spacing:1px}
    .call-modal-name{font-size:14px;color:var(--muted);text-align:center;margin-bottom:8px}
    .call-actions{display:flex;gap:8px;margin-top:16px}
    .call-actions .btn{flex:1}

    .no-data{text-align:center;padding:30px 20px;color:var(--muted)}
    .no-data .nd-icon{font-size:36px;margin-bottom:6px}
    .no-data .nd-text{font-size:13px}

    /* Toast */
    .toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--surface);border:1px solid var(--border);color:var(--text);padding:10px 20px;border-radius:12px;font-size:13px;font-weight:600;z-index:300;box-shadow:0 8px 30px rgba(0,0,0,0.5);opacity:0;transition:opacity 0.3s ease;pointer-events:none}
    .toast.show{opacity:1}

    @keyframes slideUp{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}
    .modal.show .modal-content{animation:slideUp 0.25s ease}
    ::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.1);border-radius:2px}
  </style>
</head>
<body>
  <header>
    <div class="header-inner">
      <div class="brand">
        <div class="logo">SF</div>
        <div><h1>SR Finance</h1><p>Admin Panel</p></div>
      </div>
      <div style="display:flex;gap:6px;align-items:center">
        <a href="loan-registration.html" class="btn btn-sm btn-ghost" style="text-decoration:none;font-size:12px">📝 New</a>
      </div>
    </div>
  </header>

  <main class="page">
    <div class="action-row">
      <button class="action-chip green" onclick="openCollectionPage()">💰 Collection</button>
