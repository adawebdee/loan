    /* ===== EDIT CUSTOMER ===== */
    function openEditCustomerFromDetail(){
      if(!viewingCustId)return;
      editingCustId=viewingCustId;
      const c=findCust(editingCustId);
      if(!c){alert('Customer not found');return}
      document.getElementById('ecName').value=c.name||'';
      document.getElementById('ecParentName').value=c.parentName||'';
      document.getElementById('ecPhone').value=c.phone||'';
      document.getElementById('ecAadhar').value=c.aadhar||'';
      document.getElementById('ecAddress').value=c.address||'';
      document.getElementById('ecState').value=c.state||'';
      document.getElementById('ecCity').value=c.city||'';
      document.getElementById('ecLoanAmount').value=c.loanAmount||'';
      document.getElementById('ecInterestRate').value=c.interestRate||'';
      document.getElementById('ecInstallmentAmount').value=c.installmentAmount||'';
      document.getElementById('ecPaymentType').value=c.paymentType||'monthly';
      closeModal('customerDetailModal');
      document.getElementById('editCustomerModal').classList.add('show');
      setTimeout(()=>document.getElementById('ecName').focus(),100);
    }

    function saveEditCustomer(){
      if(!editingCustId)return;
      const sk=editingCustId.replace(/[.$#[\]/]/g,'_');
      const loanAmount=Number(document.getElementById('ecLoanAmount').value)||0;
      const interestRate=Number(document.getElementById('ecInterestRate').value)||0;
      const installmentAmount=Number(document.getElementById('ecInstallmentAmount').value)||0;
      const commissionFee=Math.floor(loanAmount/5000)*100;
      const customerReceives=Math.max(0,loanAmount-commissionFee);
      const interestAmount=(loanAmount*interestRate)/100;
      const totalPayable=loanAmount+interestAmount;
      const numberOfInstallments=installmentAmount>0?Math.ceil(totalPayable/installmentAmount):0;

      const updates={
        name:document.getElementById('ecName').value.trim(),
        parentName:document.getElementById('ecParentName').value.trim(),
        phone:document.getElementById('ecPhone').value.trim(),
        aadhar:document.getElementById('ecAadhar').value.trim(),
        address:document.getElementById('ecAddress').value.trim(),
        state:document.getElementById('ecState').value.trim(),
        city:document.getElementById('ecCity').value.trim(),
        loanAmount,interestRate,installmentAmount,
        paymentType:document.getElementById('ecPaymentType').value,
        commissionFee,customerReceives,interestAmount,totalPayable,numberOfInstallments,
        editedAt:Date.now()
      };

      database.ref('customers/'+sk).update(updates)
        .then(()=>{closeModal('editCustomerModal');editingCustId=null;showToast('✅ Customer updated!')})
        .catch(err=>{console.error(err);alert('Failed to update customer')});
    }

    /* ===== COPY TEXT ===== */
    function copyText(text,btnEl){
      if(!text)return;
      navigator.clipboard.writeText(text).then(()=>{
        if(btnEl){btnEl.classList.add('copied');btnEl.textContent='✅';setTimeout(()=>{btnEl.classList.remove('copied');btnEl.textContent='📋'},1500)}
        showToast('📋 Copied to clipboard!');
      }).catch(()=>{
        const ta=document.createElement('textarea');ta.value=text;
        document.body.appendChild(ta);ta.select();document.execCommand('copy');
        document.body.removeChild(ta);
        if(btnEl){btnEl.classList.add('copied');btnEl.textContent='✅';setTimeout(()=>{btnEl.classList.remove('copied');btnEl.textContent='📋'},1500)}
        showToast('📋 Copied to clipboard!');
      });
    }

    /* ===== TOAST ===== */
    function showToast(msg){
      const t=document.getElementById('toast');
      t.textContent=msg;t.classList.add('show');
      setTimeout(()=>t.classList.remove('show'),2500);
    }

    /* ===== MODAL HELPER ===== */
    function closeModal(id){document.getElementById(id).classList.remove('show')}

    /* ===== DATA HELPERS ===== */
    function getCustPayments(custId){
      const sk=custId.replace(/[.$#[\]/]/g,'_');
      const p=allPayments[sk];if(!p)return[];
      return Object.entries(p).map(([k,v])=>({...v,_key:k}));
    }
    function getCustPaid(custId){return getCustPayments(custId).reduce((s,p)=>s+(Number(p.amount)||0),0)}
    function getAllPaymentsList(){
      const list=[];
      Object.entries(allPayments).forEach(([ck,ps])=>{
        if(ps&&typeof ps==='object')Object.entries(ps).forEach(([pk,pv])=>{list.push({...pv,_key:pk,_custKey:ck})});
      });
      return list;
    }
    function findCust(custId){const sk=custId.replace(/[.$#[\]/]/g,'_');return allCustomers[sk]||null}
    function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
    function safeId(s){return String(s||'').replace(/[^a-zA-Z0-9]/g,'_')}

    /* Navigation */
    function openCollectionPage(){
      alert('Money Collection page coming soon!');
      // window.location.href = 'money-collection.html';
    }
    function openExpensesPage(){
      alert('Expenses page coming soon!');
      // window.location.href = 'expenses.html';
    }

    // Close modals on backdrop
    document.querySelectorAll('.modal').forEach(m=>{
      m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('show')});
    });
  </script>
</body>
